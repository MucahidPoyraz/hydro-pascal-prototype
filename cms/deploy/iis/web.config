<?xml version="1.0" encoding="utf-8"?>
<!-- HydroPascal CMS on IIS + iisnode (Plesk Windows). Every request goes to the Node app:
     public pages are rendered from the MSSQL content, so IIS must not serve tr/ en/ files directly. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="hp-server.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="HydroPascal CMS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="hp-server.cjs" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Form attachments up to 10 MB + multipart overhead. -->
        <requestLimits maxAllowedContentLength="12582912" />
        <hiddenSegments>
          <add segment="cms" />
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Let the app's own 404/500 pages through. -->
    <httpErrors existingResponse="PassThrough" />
    <iisnode node_env="production" loggingEnabled="true" devErrorsEnabled="false" watchedFiles="web.config;hp-server.cjs" />
  </system.webServer>
</configuration>
