ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN=replace-with-a-long-random-secret

# Content store (pages, products, posts, menus, leads, backups, audit) — MSSQL when configured.
# Real values go in .env.local (never commit them). Tables are created on first start;
# copy an existing data/content.json in with: npm run migrate:mssql
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Setting CMS_DATA_DIR switches to the JSON file store (isolated test servers rely on this),
# unless CMS_STORAGE=mssql. CMS_STORAGE=file|mssql forces a store. Uploads and form
# attachments are always files under CMS_DATA_DIR (default ./data).
# CMS_STORAGE=
# CMS_DATA_DIR=./data
# Production email (optional): SMTP connection enables automatic receipt and admin email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# SEO + measurement (server-side, read at request time — no rebuild needed).
# These are PUBLIC identifiers, not secrets; they are still kept out of the code.
# Env values win over the admin "SEO ve ölçüm" settings and lock those fields.
# ---------------------------------------------------------------------------
# Canonical / sitemap / Open Graph / JSON-LD origin. Required in production.
SITE_URL=https://www.hydropascal.com.tr
# false → robots.txt "Disallow: /" and noindex on every page (staging / preview hosts).
SEARCH_INDEXING=
# Tags load by default only when NODE_ENV=production. Set true to test elsewhere, false to switch off.
ANALYTICS_ENABLED=
# true → events are logged in the browser console and GA4 debug_mode is on. Never in production.
ANALYTICS_DEBUG=
# Google: set GTM_CONTAINER_ID (then GA4/Ads/Meta/LinkedIn are configured INSIDE GTM)
# or GA4_MEASUREMENT_ID (+ optional Ads) for direct gtag.js. Never both — prevents double counting.
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=
META_PIXEL_ID=
LINKEDIN_PARTNER_ID=
LINKEDIN_LEAD_CONVERSION_ID=
# Search Console / Bing HTML-tag verification (only the content="…" value). DNS verification needs none.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
